.DS_Store
node_modules/
target/
dist/
__pycache__/
*.pyc
.venv/
.claude/
raw/*/.venv/
raw/*/node_modules/
raw/bench_stack/rust_engine/target/
# everything the engines WRITE under out/ is output; only spec/ and grammar/ are inputs
raw/bench_stack/out/*
!raw/bench_stack/out/spec/
!raw/bench_stack/out/grammar/
backend/target/
# build output of `lineageq_store convert` / `main.rs`'s default --db, not source
backend/*.duckdb

# agent debug artifacts (console logs, page dumps, screenshots), not source
.playwright-mcp/

# DuckDB write-ahead log: regenerated whenever the server runs; the .duckdb
# beside it opens clean on its own (verified 2026-09-10), so only the db is tracked
*.duckdb.wal

# the repo-root symlink to raw/node4_viz/node_modules, so `node tools/shot_ui1.mjs`
# resolves Playwright from the repo root (M1/G4). `node_modules/` above does not match
# it: a trailing slash only matches a directory, and this is a symlink.
/node_modules
# TypeScript incremental build state, regenerated by every `tsc -b` (M1/G4)
frontend/ui_across_file_ui/tsconfig.tsbuildinfo
