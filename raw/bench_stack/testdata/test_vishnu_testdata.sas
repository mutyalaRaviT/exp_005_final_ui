/* exp_42 TEST DATA VERSION of test_vishnu.sas (generated by testdata/gen_testdata.py, 2026-09-05).
   Same program, only the DATALINES changed: 22 rows, one per branch leg Z3 found in node/4,
   plus boundary rows (month 3/4, amount = / just under / just over the average = 150),
   plus one row per month so MONTHLY_SALES has 12 groups.
   HOW TO RUN: point LIBNAME SALES at a folder you own (SAS OnDemand: e.g. '/home/<your-id>/sales'),
   run, and send back the PROC PRINT output at the bottom plus the LOG (the MERGE step logs an ERROR on purpose). */

/* Define library */

/*BLOCKID 2:6887988991394376008, LIBNAME, Lines: 3 - 9 to 12 : 6%;*/
libname sales 'C:\SASData\Sales';
/*ENDBLOCKID 2:6887988991394376008, LIBNAME;*/

/* Create Sales Data */

/*BLOCKID 4:6887988991394376008, DataStep, Lines: 12 - 15 to 27 : 14%;*/
data sales.sales_data;
input sale_id $ sale_amount date :mmddyy10.;
format date mmddyy10.;
datalines;
